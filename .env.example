# ==============================================================================
# CLIENTUM CRM & ERP - ARCHIVO DE CONFIGURACIÓN DE PRODUCCIÓN (.env.example)
# ==============================================================================
# Base de datos principal: Firebase Firestore (No requiere PostgreSQL / Neon).
# Credenciales de producción completas con enlaces oficiales.
# ==============================================================================

# --- 1. CONFIGURACIÓN GENERAL DEL SERVIDOR ---
PORT=3000
NODE_ENV=production
DISABLE_HMR=true

# --- 2. SEGURIDAD Y ENCRIPTACIÓN DEL SERVIDOR ---
# Clave para encriptar credenciales de integraciones y workflows en la base de datos.
# Generador recomendado: openssl rand -hex 32
WORKFLOW_ENCRYPTION_KEY=
# Pepper de seguridad para hashing de API Keys de usuarios.
API_KEY_PEPPER=
# Secreto para sesiones seguras en Express.
SESSION_SECRET=
# IDs de usuarios con privilegios de administrador en la API (separados por comas).
CLIENTUM_API_KEY_ADMIN_IDS=

# --- 3. INTEGRACIÓN VERCEL ---
# Token de acceso personal y ID de equipo para automatización y despliegues con Vercel.
# Enlace: https://vercel.com/account/tokens
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=

# --- 4. INTEGRACIÓN CLOUDFLARE ---
# Token de API de Cloudflare con permisos para gestión de DNS, Workers y Webmail.
# Enlace: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# --- 5. FIREBASE ADMIN (SERVIDOR - PERSISTENCIA Y AUTENTICACIÓN) ---
# Credenciales del SDK Admin de Firebase para Firestore y Auth.
# Enlace: https://console.firebase.google.com/
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- 6. FIREBASE CLIENTE (VITE / FRONTEND) ---
# Configuración pública de Firebase SDK para el navegador.
# Enlace: Consola de Firebase > Configuración del proyecto > General > SDK Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=

# --- 7. CORREO ELECTRÓNICO (RESEND & SMTP) ---
# Resend para envío de correos transaccionales y facturación (https://resend.com)
# RESEND_API_KEY: Clave de API generada en https://resend.com/api-keys (comienza con re_)
RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM_EMAIL: Remitente de tu dominio verificado en Resend (ej. "Acme <hola@tudominio.com>" o "onboarding@resend.dev" para pruebas)
RESEND_FROM_EMAIL="Clientum CRM <onboarding@resend.dev>"
# Servidor SMTP alternativo opcional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- 8. PLATAFORMA DE PAGOS Y SUSCRIPCIONES (MERCADO PAGO) ---
# URL pública HTTPS del servidor en producción (ej. https://tu-dominio.com)
APP_URL=
# Access Token de tu aplicación en Mercado Pago Developers (https://www.mercadopago.com.ar/developers/)
# Producción: empieza con APP_USR-... | Pruebas: empieza con TEST-...
PLATFORM_MERCADOPAGO_ACCESS_TOKEN=
# Secreto de firma para validación de Webhooks e IPN
PLATFORM_MERCADOPAGO_WEBHOOK_SECRET=
# IDs de planes de suscripción preaprobados (POST https://api.mercadopago.com/preapproval_plan)
PLATFORM_MP_PLAN_ID_STARTER_MONTHLY=
PLATFORM_MP_PLAN_ID_STARTER_ANNUAL=
PLATFORM_MP_PLAN_ID_GROWTH_MONTHLY=
PLATFORM_MP_PLAN_ID_GROWTH_ANNUAL=
PLATFORM_MP_PLAN_ID_SCALE_MONTHLY=
PLATFORM_MP_PLAN_ID_SCALE_ANNUAL=
