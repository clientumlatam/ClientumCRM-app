# ClientumCRM runtime variables
# Never commit real values. Store secrets in Replit Secrets.

PORT=3000
NODE_ENV=development
DISABLE_HMR=false

# Neon PostgreSQL (preferred). DATABASE_URL / PG* are compatibility fallbacks.
NEON_DATABASE_URL=
# DATABASE_URL=
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=

# Server encryption and internal API keys
WORKFLOW_ENCRYPTION_KEY=
API_KEY_PEPPER=
SESSION_SECRET=
CLIENTUM_API_KEY_ADMIN_IDS=

# Vercel REST API (keep the token server-side; prefer a project-scoped token)
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=

# Cloudflare API (keep the token server-side and scope it to required resources)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Firebase client configuration (also automatically read from firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Resend API for transactional emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMTP Delivery (Optional fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Workspace credentials are entered in the app and encrypted server-side:
# MERCADOPAGO_ACCESS_TOKEN
# MERCADOPAGO_WEBHOOK_SECRET
# MERCADOPAGO_PUBLIC_KEY
# GOOGLE_MAPS_SERVER_API_KEY
# WHATSAPP_ACCESS_TOKEN
# WHATSAPP_PHONE_NUMBER_ID
# WHATSAPP_BUSINESS_ACCOUNT_ID