# ClientumCRM runtime variables
# Never commit real values. Store secrets in Replit Secrets.

PORT=3000
NODE_ENV=development
DISABLE_HMR=false

# Neon PostgreSQL (preferred). DATABASE_URL / PG* are compatibility fallbacks.
NEON_DATABASE_URL=
# DATABASE_URL=
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=

# Server encryption and internal API keys
WORKFLOW_ENCRYPTION_KEY=
API_KEY_PEPPER=
SESSION_SECRET=
CLIENTUM_API_KEY_ADMIN_IDS=

# Vercel REST API (keep the token server-side; prefer a project-scoped token)
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=

# Cloudflare API (keep the token server-side and scope it to required resources)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Firebase Admin server configuration. Keep these values in Replit Secrets or
# the deployment environment; never expose them through VITE_*.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase client configuration (also automatically read from firebase-applet-config.json).
# Enable Email/Password and the providers used by the sign-in buttons in
# Firebase Console > Authentication > Sign-in method. When these values are
# configured, CRM data is available only after Firebase Auth reports a user.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Optional. Leave empty to use the project's default Firestore database.
VITE_FIREBASE_DATABASE_ID=

# Resend API for transactional emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMTP Delivery (Optional fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Platform billing (Mercado Pago recurring subscriptions)
# Keep these server-side in Replit Secrets. A public HTTPS APP_URL is required
# so Mercado Pago can return to the app and deliver webhook notifications.
APP_URL=
PLATFORM_MERCADOPAGO_ACCESS_TOKEN=
PLATFORM_MERCADOPAGO_WEBHOOK_SECRET=
# Optional preapproval plan IDs. If empty, the server creates an inline recurring subscription.
PLATFORM_MP_PLAN_ID_STARTER_MONTHLY=
PLATFORM_MP_PLAN_ID_STARTER_ANNUAL=
PLATFORM_MP_PLAN_ID_GROWTH_MONTHLY=
PLATFORM_MP_PLAN_ID_GROWTH_ANNUAL=
PLATFORM_MP_PLAN_ID_SCALE_MONTHLY=
PLATFORM_MP_PLAN_ID_SCALE_ANNUAL=

# Workspace credentials are entered in the app and encrypted server-side:
# OPENROUTER_API_KEY
# OPENAI_API_KEY
# MERCADOPAGO_ACCESS_TOKEN
# MERCADOPAGO_WEBHOOK_SECRET
# MERCADOPAGO_PUBLIC_KEY
# GOOGLE_MAPS_SERVER_API_KEY
# WHATSAPP_ACCESS_TOKEN
# WHATSAPP_PHONE_NUMBER_ID
# WHATSAPP_BUSINESS_ACCOUNT_ID